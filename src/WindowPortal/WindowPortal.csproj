<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PierceView</AssemblyName>
    <RootNamespace>WindowPortal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <InformationalVersion>2.3.0-multilayer-alpha.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>寸镜 / PierceView</Product>
    <Company>PierceView Project</Company>
    <Description>GPU 多窗口遮挡重建实验版；最多识别宿主后方四层窗口</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\brand\pierceview-logo.png"
                      LogicalName="PierceView.Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>
</Project>
