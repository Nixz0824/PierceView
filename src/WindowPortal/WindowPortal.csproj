<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WindowPortal</AssemblyName>
    <RootNamespace>WindowPortal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <InformationalVersion>0.7.0</InformationalVersion>
    <Product>WindowPortal</Product>
    <Company>WindowPortal Project</Company>
    <Description>受限层级提升与多层 DWM 圆形窗口合成工具</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
