<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PierceView</AssemblyName>
    <RootNamespace>WindowPortal</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.0-cpu-alpha.1</Version>
    <AssemblyVersion>2.1.0.0</AssemblyVersion>
    <FileVersion>2.1.0.0</FileVersion>
    <InformationalVersion>2.1.0-cpu-alpha.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>寸镜 / PierceView</Product>
    <Company>PierceView Project</Company>
    <Description>单层羽化圆形与圆角矩形窗口透视托盘工具</Description>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\brand\pierceview-logo.png"
                      LogicalName="PierceView.Logo.png" />
  </ItemGroup>
</Project>
